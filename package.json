{
	"name": "svelte-monorepo-template",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev": "turbo run dev",
		"db:start": "pnpm --filter @repo/db supabase:start",
		"db:stop": "pnpm --filter @repo/db supabase:stop",
		"db:status": "pnpm --filter @repo/db supabase:status",
		"db:reset": "pnpm --filter @repo/db supabase:reset",
		"format": "prettier --write .",
		"lint": "turbo run lint",
		"lint-staged": "lint-staged",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.astro": "prettier --write",
		"*.{json,md}": "prettier --write"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/compat": "catalog:",
		"@repo/eslint-config": "workspace:*",
		"eslint": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "catalog:",
		"turbo": "^2.11.2",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": ">=24"
	}
}
